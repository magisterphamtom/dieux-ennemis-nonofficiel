{{!-- FICHE PNJ (Figurant / Premier Rôle / Second Rôle) --}}
<div class="de-sheet-wrap">

  <header class="de-header">
    <div class="de-header-top">
      <img class="de-avatar" src="{{actor.img}}" title="{{actor.name}}" data-edit="img">
      <div class="de-header-info">
        <input class="de-actor-name" type="text" name="name" value="{{actor.name}}" placeholder="Nom du personnage"/>
        <div class="de-header-meta">
          {{#if isPR}}
          <label class="de-meta-item">Rang :
            <select name="system.blessures.max" data-dtype="Number">
              <option value="10" {{#ifEq system.blessures.max 10}}selected{{/ifEq}}>Premier rôle (10 blessures)</option>
              <option value="5" {{#ifEq system.blessures.max 5}}selected{{/ifEq}}>Second rôle (5 blessures)</option>
            </select>
          </label>
          {{else}}
          <span class="de-meta-item">Figurant — tombe au premier succès</span>
          {{/if}}
        </div>
      </div>
    </div>
    {{#if editable}}
    <div class="de-header-actions">
      <button type="button" class="de-btn-action btn-roll-attaque"><i class="fas fa-sword"></i> Attaque</button>
      <button type="button" class="de-btn-action btn-roll-initiative"><i class="fas fa-running"></i> Initiative</button>
    </div>
    {{/if}}
  </header>

  <div class="sheet-body de-pnj-body">

    {{!-- ── Bandeau de combat ─────────────────────────────── --}}
    <div class="de-pnj-banner">
      <div class="de-pnj-stat">
        <span class="de-pnj-stat-lbl">Dévotion combat</span>
        {{#if isPR}}
        <span class="de-pnj-stat-val">{{devoCombat}}</span>
        {{else}}
        <input class="de-pnj-stat-input" type="number" name="system.devotionCombat" value="{{system.devotionCombat}}" min="0" max="10">
        {{/if}}
      </div>
      {{#if isPR}}
      <div class="de-pnj-stat" title="Difficulté pour le toucher : Dévotion Champs de bataille + avantages défensifs">
        <span class="de-pnj-stat-lbl">Défense</span>
        <span class="de-pnj-stat-val">{{defense}}</span>
        <span class="de-pnj-stat-sub">{{devoCombat}} + {{bonusDefensif}} armure</span>
      </div>
      <div class="de-pnj-stat de-pnj-stat-seuil" title="Combat perdu si l'adversaire obtient autant de succès en une attaque">
        <span class="de-pnj-stat-lbl">Seuil de défaite</span>
        <span class="de-pnj-stat-val">{{seuil}}</span>
      </div>
      <div class="de-pnj-stat" title="Gagnés par ses attaques réussies, perdus au premier échec">
        <span class="de-pnj-stat-lbl">Dés-avantages acquis</span>
        <input class="de-pnj-stat-input" type="number" name="system.desAvantages" value="{{system.desAvantages}}" min="0">
      </div>
      {{/if}}
    </div>

    {{!-- ── Blessures ─────────────────────────────────────── --}}
    <div class="de-section">
      <h3 class="de-section-title">
        Blessures
        <span class="de-section-title-deco">{{system.blessures.value}} / {{system.blessures.max}}</span>
      </h3>
      <div class="de-section-body">
        <div class="de-blessures-wrap">
          <div class="de-blessures-row">
            {{#each blessuresArr}}
            <div class="blessure-case {{#if filled}}filled{{/if}}" data-idx="{{idx}}"></div>
            {{/each}}
          </div>
        </div>
      </div>
    </div>

    {{#if isPR}}
    {{!-- ── Dévotions ─────────────────────────────────────── --}}
    <div class="de-section">
      <h3 class="de-section-title">Dévotions</h3>
      <div class="de-section-body">
        <div class="de-pnj-devotions">
          {{#each devotionsArr as |d|}}
          <div class="de-pnj-dev">
            <div class="de-pnj-dev-txt">
              <span class="de-pnj-dev-nom">{{d.name}}</span>
              <small>{{d.domaine}}</small>
            </div>
            <input type="number" name="system.devotions.{{d.id}}" value="{{d.val}}" min="0" max="10">
            <button type="button" class="de-pnj-dev-roll roll-devotion" data-god="{{d.id}}" title="Lancer un risque">
              <i class="fas fa-dice-d6"></i>
            </button>
          </div>
          {{/each}}
        </div>
      </div>
    </div>

    {{!-- ── Équipement & historiques ──────────────────────── --}}
    <div class="de-section">
      <h3 class="de-section-title">
        Équipement & historiques
      </h3>
      <div class="de-section-body">
        {{#each historiques as |h|}}
        <div class="de-pnj-item" data-item-id="{{h.id}}">
          <img src="{{h.img}}" alt="">
          <span class="de-pnj-item-nom">{{h.name}}</span>
          <span class="de-pnj-item-tag de-pnj-tag-hist">Historique +{{h.system.valeur}}</span>
          <a class="item-edit" title="Modifier"><i class="fas fa-edit"></i></a>
          <a class="item-delete" title="Supprimer"><i class="fas fa-trash"></i></a>
        </div>
        {{/each}}
        {{#each equipements as |e|}}
        <div class="de-pnj-item {{#if e.system.equipe}}de-pnj-item-on{{/if}}" data-item-id="{{e.id}}">
          <img src="{{e.img}}" alt="">
          <span class="de-pnj-item-nom">{{e.name}}</span>
          {{#if e.system.desAvantages}}<span class="de-pnj-item-tag">⚔ +{{e.system.desAvantages}}</span>{{/if}}
          {{#if e.system.bonusDefensif}}<span class="de-pnj-item-tag">🛡 +{{e.system.bonusDefensif}}</span>{{/if}}
          {{#if e.system.malusMouvement}}<span class="de-pnj-item-tag">🦶 −{{e.system.malusMouvement}}</span>{{/if}}
          <a class="equip-toggle" title="{{#if e.system.equipe}}Déséquiper{{else}}Équiper{{/if}}">
            <i class="fas {{#if e.system.equipe}}fa-check-circle{{else}}fa-circle{{/if}}"></i></a>
          <a class="item-edit" title="Modifier"><i class="fas fa-edit"></i></a>
          <a class="item-delete" title="Supprimer"><i class="fas fa-trash"></i></a>
        </div>
        {{/each}}
        <p class="de-pnj-vide">{{#unless hasItems}}Aucun objet. {{/unless}}Glisse ici des armes, armures ou historiques depuis les compendiums.</p>
      </div>
    </div>
    {{/if}}

    {{!-- ── Notes ─────────────────────────────────────────── --}}
    <div class="de-section">
      <h3 class="de-section-title">{{#if isPR}}Notes{{else}}Description{{/if}}</h3>
      <div class="de-section-body">
        {{#if isPR}}
        <textarea name="system.notes" rows="4" class="de-editor-field">{{system.notes}}</textarea>
        {{else}}
        <textarea name="system.description" rows="4" class="de-editor-field">{{system.description}}</textarea>
        {{/if}}
      </div>
    </div>

  </div>
</div>
